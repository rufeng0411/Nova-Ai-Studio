{
  "name": "nova-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Nova Ai-Studio SaaS dev stack launcher (Electron)",
  "main": "dist-main/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:watch:main\" \"npm:watch:preload\" \"npm:dev:renderer\" \"npm:electron\"",
    "postinstall": "node -e \"try{require('electron/install')}catch(e){}\"",
    "verify:preload": "npm run build:main && electron scripts/verify-preload.mjs",
    "verify:ui": "npm run build && electron scripts/verify-ui.mjs",
    "test:supervisor": "npm run build:main && node scripts/test-supervisor.mjs",
    "test:all": "node scripts/run-launcher-tests.mjs",
    "test:quick": "cross-env LAUNCHER_SKIP_SMOKE_BOOT=1 node scripts/run-launcher-tests.mjs",
    "smoke:boot": "npm run build:main && node scripts/smoke-boot.mjs",
    "start": "node scripts/start-hidden.mjs",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:preload": "tsc -p tsconfig.preload.json && node scripts/finalize-preload.mjs && concurrently \"tsc -p tsconfig.preload.json --watch\" \"node scripts/watch-preload-finalize.mjs\"",
    "dev:renderer": "vite",
    "electron": "wait-on dist-main/main/index.js dist-preload/preload/index.cjs http://127.0.0.1:5199 && cross-env NODE_ENV=development electron .",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/finalize-preload.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "ws": "^8.18.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "to-ico": "^2.1.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "online.novapage.dev-launcher",
    "productName": "Nova Dev Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-main/**/*",
      "dist-preload/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "NovaLauncher-${version}-win.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "artifactName": "NovaLauncher-${version}-linux.${ext}"
    },
    "portable": {
      "artifactName": "NovaLauncher.exe"
    }
  }
}
