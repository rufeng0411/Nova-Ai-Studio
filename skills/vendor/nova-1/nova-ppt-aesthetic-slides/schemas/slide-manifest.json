{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novapage.local/skills/ppt-aesthetic-slides/schemas/slide-manifest.json",
  "title": "PPT Slide Deck Manifest",
  "description": "Phase E deliverable: deck metadata plus per-page description and image paths.",
  "type": "object",
  "required": [
    "skill_version",
    "deck_title",
    "idea_prompt",
    "preset_id",
    "template_style",
    "aspect_ratio",
    "language",
    "detail_level",
    "page_count",
    "pages"
  ],
  "properties": {
    "skill_version": {
      "type": "string",
      "description": "Skill directory revision tag, e.g. 1.0.0"
    },
    "deck_title": {
      "type": "string",
      "minLength": 1
    },
    "idea_prompt": {
      "type": "string",
      "description": "Topic after style stripping"
    },
    "preset_id": {
      "type": ["string", "null"],
      "description": "One of presets/*.md slug, or null if custom template_style only"
    },
    "template_style": {
      "type": "string",
      "minLength": 1,
      "description": "Full style text injected into image extra_requirements"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["16:9", "9:16", "4:3", "1:1", "3:4"]
    },
    "language": {
      "type": "string",
      "description": "zh | en or BCP-47 tag"
    },
    "detail_level": {
      "type": "string",
      "enum": ["concise", "default", "detailed"]
    },
    "page_count": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "image_model": {
      "type": "string",
      "description": "Optional: model name used for Phase D"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_index", "title", "page_description", "status"],
        "properties": {
          "page_index": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "points": {
            "type": "array",
            "items": { "type": "string" }
          },
          "page_description": {
            "type": "string",
            "minLength": 1,
            "description": "Phase C plain text; no markdown heading symbols"
          },
          "image_path": {
            "type": "string",
            "description": "Relative path to slide-NN.png when status=completed"
          },
          "status": {
            "type": "string",
            "enum": ["completed", "failed", "pending"]
          },
          "error": {
            "type": "string",
            "description": "Present when status=failed"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
