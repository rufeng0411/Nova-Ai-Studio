{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nova.ai/schemas/bento-outline.schema.json",
  "title": "Bento Deck Outline",
  "type": "object",
  "required": ["title", "themePreset", "slides"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "themePreset": { "type": "string", "minLength": 1 },
    "audience": { "type": "string" },
    "notesMode": { "type": "string", "enum": ["A", "B", "C"] },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layout", "rhythm", "headline"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "layout": {
            "type": "string",
            "enum": [
              "cover-hero", "title-only", "headline-body", "split-text-image",
              "two-column", "three-up-cards", "chart-full", "chart-split-caption",
              "table-pricing", "kpi-row", "timeline-flow", "closing-cta"
            ]
          },
          "rhythm": { "type": "string", "enum": ["anchor", "dense", "breathing"] },
          "transition": { "type": "string", "enum": ["none", "fade", "slide", "zoom", "morph"] },
          "headline": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "morphIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
