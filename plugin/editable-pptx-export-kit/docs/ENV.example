# 可编辑 PPTX 导出 — 环境变量（摘自 NovaPage .env.example 相关项）

# ── MinerU 版面分析（hybrid/mineru 提取器）──
MINERU_TOKEN=
MINERU_API_BASE=https://mineru.net

# ── 百度 OCR / 图像修复（hybrid 文字定位、baidu inpaint）──
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ── 生成式 inpaint / VLM 文字样式（generative、hybrid+增强、CaptionModel）──
# 按你项目 AI 网关配置，例如 GEMINI / OPENAI / 统一 LazyLLM 等（见原仓库 ai_service）

# ── 性能调优（可选）──
PPT_EXPORT_MINERU_CACHE=1
PPT_EXPORT_DEFAULT_INPAINT_METHOD=baidu
PPT_EXPORT_INPAINT_ENHANCE_QUALITY=0
PPT_EXPORT_MAX_WORKERS=12
PPT_EXPORT_PPTX_MAX_LONG_EDGE=1920
PPT_EXPORT_PPTX_JPEG_QUALITY=82
PPT_EXPORT_PPTX_NO_RECOMPRESS=0

# 上传目录（MinerU 缓存 mineru_cache/、mineru_files/ 落盘）
UPLOAD_FOLDER=./uploads
