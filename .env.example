# Nova Ai-Studio community (personal SaaS). Copy to .env — never commit .env.
# Process refuses to start without SAAS_ADMIN_PASSWORD. Do not use the historic default password.

SAAS_ADMIN_PASSWORD=ChangeMe_Admin1!
PILOTDECK_COMMUNITY_PERSONAL=1
PILOTDECK_SAAS_MODE=1
PILOTDECK_MARKETING_SITE=0
VITE_PILOTDECK_MARKETING_SITE=0
PILOTDECK_REGISTER_INVITE_CODE=0
DEV_SAAS_SQLITE=1

